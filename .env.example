# Export only the variables needed by the selected pipeline.
# This file is a variable checklist; TRACE does not load .env automatically.
# Set values with `export NAME=value` in your terminal, or use a shell env file.
# Raw-module training and scoring:
TRACE_RAW_INPUT_DIR=
TRACE_MODULE_CATALOG=
TRACE_MODULE_MODEL_DIR=
# Optional train-only fold table, referenced only by a matching profile:
TRACE_FOLD_TABLE=
# Prepared score/target bundle and downstream models:
TRACE_INPUT_DIR=
TRACE_INPUT_PREFIX=
TRACE_SPLIT_TABLE=
TRACE_FUSION_MODEL=
# Prevalent validation-fitted calibration_model.joblib, kept with the frozen models.
TRACE_CALIBRATORS=
TRACE_Q_MODEL=
TRACE_KNOWLEDGE_MATRIX=
TRACE_BURDEN_PROFILE=
# TRACE_BURDEN_PROFILE is used by a custom profile; canonical templates use the
# bundled UKB burden file unless artifacts.burden_profile is overridden.
# Optional external baseline NPZ; used only by the explicit absolute-risk profile.
TRACE_ABSOLUTE_RISK=
TRACE_CONTRIBUTIONS=
TRACE_FEATURE_NAMES=
TRACE_FEATURE_WEIGHTS=
TRACE_EVIDENCE_WEIGHTS=
TRACE_PREDICTIONS=
TRACE_OUTPUT_DIR=

# Optional explanation providers. Core assessment does not require them.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
